{
  "git": { "deploymentEnabled": { "main": false } },
  "routes": [
    { "src": "/", "has": [{ "type": "host", "value": "filaz.com.br" }], "dest": "/site/index.html", "headers": { "Cache-Control": "no-store, no-cache, must-revalidate" } },
    { "src": "/", "has": [{ "type": "host", "value": "www.filaz.com.br" }], "dest": "/site/index.html", "headers": { "Cache-Control": "no-store, no-cache, must-revalidate" } },
    { "src": "/(.*)", "headers": { "Cache-Control": "no-store, no-cache, must-revalidate" }, "continue": true },
    { "handle": "filesystem" }
  ]
}
