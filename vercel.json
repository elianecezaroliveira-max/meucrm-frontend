{
  "git": { "deploymentEnabled": { "main": false } },
  "rewrites": [
    { "source": "/", "has": [{ "type": "host", "value": "filaz.com.br" }], "destination": "/site/index.html" },
    { "source": "/", "has": [{ "type": "host", "value": "www.filaz.com.br" }], "destination": "/site/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ]
}
